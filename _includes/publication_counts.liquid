{% assign counts = site.data.publication_counts %}
{% if counts %}
<div class="publication-counts mb-4">
  <!-- Level 1: Published / Accepted / In press -->
  <div class="publication-count-section mb-3">
    <div class="publication-count-section-title mb-2">
      <span class="publication-count-number publication-count-published-num">{{ counts.published_total | default: 0 }}</span>
      <span class="publication-count-section-label">Published / accepted / in press</span>
    </div>
    <div class="row g-2 g-md-3">
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-published">
          <span class="publication-count-number">{{ counts.published_journals | default: 0 }}</span>
          <span class="publication-count-label d-block small">{% if counts.published_journals == 1 %}Journal{% else %}Journals{% endif %}</span>
        </div>
      </div>
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-published">
          <span class="publication-count-number">{{ counts.published_conferences | default: 0 }}</span>
          <span class="publication-count-label d-block small">{% if counts.published_conferences == 1 %}Conference{% else %}Conferences{% endif %}</span>
        </div>
      </div>
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-published">
          <span class="publication-count-number">{{ counts.published_book_chapters | default: 0 }}</span>
          <span class="publication-count-label d-block small">Book chapter{% if counts.published_book_chapters != 1 %}s{% endif %}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Level 2: In review -->
  <div class="publication-count-section">
    <div class="publication-count-section-title mb-2">
      <span class="publication-count-number publication-count-review-num">{{ counts.in_review_total | default: 0 }}</span>
      <span class="publication-count-section-label">In review</span>
    </div>
    <div class="row g-2 g-md-3">
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-review">
          <span class="publication-count-number">{{ counts.in_review_journals | default: 0 }}</span>
          <span class="publication-count-label d-block small">{% if counts.in_review_journals == 1 %}Journal{% else %}Journals{% endif %}</span>
        </div>
      </div>
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-review">
          <span class="publication-count-number">{{ counts.in_review_conferences | default: 0 }}</span>
          <span class="publication-count-label d-block small">{% if counts.in_review_conferences == 1 %}Conference{% else %}Conferences{% endif %}</span>
        </div>
      </div>
      <div class="col-4 col-md">
        <div class="publication-count-card border rounded px-2 py-2 text-center publication-count-review">
          <span class="publication-count-number">{{ counts.in_review_book_chapters | default: 0 }}</span>
          <span class="publication-count-label d-block small">Book chapter{% if counts.in_review_book_chapters != 1 %}s{% endif %}</span>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
.publication-counts .publication-count-card {
  background-color: var(--global-card-bg-color, #f8f9fa);
  border-color: var(--global-divider-color, rgba(0,0,0,0.08)) !important;
}
.publication-counts .publication-count-number {
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--global-theme-color, #2563eb);
}
.publication-counts .publication-count-label {
  color: var(--global-text-color-light, #6c757d);
}
.publication-count-section-title {
  font-size: 0.95rem;
  color: var(--global-text-color-light, #6c757d);
}
.publication-count-section-title .publication-count-published-num,
.publication-counts .publication-count-published .publication-count-number {
  color: var(--global-theme-color, #2563eb);
}
.publication-count-section-title .publication-count-review-num,
.publication-counts .publication-count-review .publication-count-number {
  color: var(--global-text-color-light, #6c757d);
}
</style>
{% endif %}
