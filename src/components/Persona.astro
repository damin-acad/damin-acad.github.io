---
/**
 * The hero: a persona of the persona researcher.
 *
 * Laid out the way data-driven personas are — portrait, attributes, a
 * representative quote — because that format is what the research interrogates.
 * No card, no border, no panel: the figure and the type sit directly on the
 * paper.
 *
 * The portrait's background is a uniform light grey (227,232,240 — 88% of its
 * border is above 200 luminance), so it is removed the way a two-ink press would
 * remove it rather than by masking: levels push the background past white, then
 * multiply lets the paper through wherever there is no ink. On black stock the
 * image inverts and screens instead, which is the same operation the other way
 * up. Nothing is cut out by hand and there is no transparent PNG to maintain.
 *
 * Every attribute is sourced — cv.yml, papers.bib, the essay collection — and
 * the quote is verbatim. A generated persona could not say that, which is the
 * point of the note at the end.
 */
import cv from '../data/cv.json';
import pubs from '../data/publications.json';
import site from '../data/site.json';

interface Props {
  essays: number;
  essayWords: number;
}
const { essays, essayWords } = Astro.props;

type Section = { title: string; type?: string; contents?: any };
const map = Object.fromEntries(
  (cv as Section[])
    .filter((s) => s.type === 'map')
    .flatMap((s) => (s.contents as { name: string; value: any }[]).map((r) => [r.name, r.value])),
);

const interests = ((cv as Section[]).find((s) => s.title === 'Research Interests')?.contents ??
  []) as { title: string; items: string[] }[];

const coauthors = new Set(pubs.flatMap((p) => p.authors).filter((a) => a !== site.name));
const years = pubs.map((p) => p.year).filter(Boolean) as number[];

const quote = {
  text:
    'This proposition, however, rests on a fundamental category error that conflates representational plausibility with representational validity.',
  slug: '2025-07-02-representation',
  where: 'The Representation Crisis',
};

const attrs = [
  ['Location', map['Location'] ?? site.location],
  ['Languages', map['Languages']],
  ['Focus', interests.map((g) => g.title).join(' · ')],
  [
    'Evidence',
    `${pubs.length} publications ${Math.min(...years)}–${Math.max(...years)} · ${coauthors.size} co-authors · ${essays} essays, ${essayWords.toLocaleString('en-GB')} words`,
  ],
];
---

<figure class="hero-persona" data-set>
  <div class="hp-figure">
    <img
      src="/prof_pic.jpg"
      alt={`Portrait of ${site.name}`}
      width="590"
      height="585"
      loading="eager"
    />
  </div>

  <div class="hp-text">
    <p class="hp-tag">Persona 01 · n = 1 · sourced, not generated</p>
    <h1 class="hp-name">{map['Full Name'] ?? site.name}</h1>
    <p class="hp-role">
      {site.role}, <a href={site.groupUrl} rel="noopener" target="_blank">{site.group}</a> ·
      {' '}{site.affiliation}
    </p>

    <dl class="hp-attrs">
      {
        attrs.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>

    <blockquote class="hp-quote">
      <p>“{quote.text}”</p>
      <footer>— <a href={`/writing/${quote.slug}`}>{quote.where}</a>, verbatim</footer>
    </blockquote>

    <figcaption class="hp-note">
      Every attribute above comes from a CV, a bibliography or a published sentence — nothing is
      inferred. A generated persona cannot make that claim, and the gap is the research: a persona
      can be entirely plausible and still represent no one.
    </figcaption>
  </div>
</figure>

<style>
  .hero-persona {
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.5rem 2rem;
    align-items: start;
  }

  @media (min-width: 780px) {
    .hero-persona {
      grid-template-columns: minmax(11rem, 17rem) 1fr;
    }
  }

  /* no frame, no background — the ink sits on the paper */
  .hp-figure {
    margin: 0;
    line-height: 0;
  }

  .hp-figure img {
    display: block;
    width: 100%;
    height: auto;
    /* push the near-white background past white so multiply erases it */
    filter: grayscale(1) contrast(1.42) brightness(1.16);
    mix-blend-mode: multiply;
  }

  /* on dark stock the same operation runs inverted and screens instead */
  :global([data-stock='black']) .hp-figure img {
    filter: grayscale(1) contrast(1.42) brightness(1.16) invert(1);
    mix-blend-mode: screen;
  }

  .hp-tag {
    margin: 0 0 0.4rem;
    font-family: var(--type);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--mark);
  }

  .hp-name {
    font-family: var(--display);
    font-size: clamp(2.1rem, 5.5vw, 3.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0 0 0.3rem;
    font-weight: 400;
  }

  .hp-role {
    margin: 0 0 1rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .hp-attrs {
    margin: 0 0 1.1rem;
    border-top: 1.5px solid var(--rule);
  }

  .hp-attrs div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.25rem 0.9rem;
    padding: 0.4rem 0;
    border-bottom: 1.5px solid var(--rule);
    font-size: 0.92rem;
  }

  .hp-attrs dt {
    font-family: var(--type);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding-top: 0.3em;
  }

  .hp-attrs dd {
    margin: 0;
    color: var(--ink);
  }

  .hp-quote {
    margin: 0 0 0.9rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--mark);
  }

  .hp-quote p {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.42;
    text-wrap: pretty;
  }

  .hp-quote footer {
    font-family: var(--type);
    font-size: 0.66rem;
    color: var(--ink-faint);
  }

  .hp-note {
    font-family: var(--type);
    font-size: 0.66rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 44rem;
  }

  @media (max-width: 520px) {
    .hp-attrs div {
      grid-template-columns: 1fr;
      gap: 0.05rem;
    }
  }
</style>
