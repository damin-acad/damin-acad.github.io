---
/**
 * The hero: a persona of the persona researcher.
 *
 * Composition — prose on the left, the figure on the right with chat-style
 * bubbles arranged around it, each carrying one sourced attribute. The bubbles
 * arrive in sequence on reveal, like messages landing.
 *
 * ─── the figure ─────────────────────────────────────────────────────────────
 * A low-poly mesh derived from the photograph by scripts/build-figure.py: the
 * image is sampled onto a jittered lattice, triangulated, and each face filled
 * with the ink level nearest its mean luminance. It resembles him because it is
 * computed from him, and it is geometry rather than a photograph.
 *
 * 646 triangles of a possible 2312 are painted; the rest cover the flat
 * (227,232,240) backdrop, land in the lightest bucket and are simply not drawn,
 * so the paper shows through with no mask and no transparent asset to maintain.
 *
 * It is inlined rather than linked so its fills can be CSS custom properties,
 * which is what lets the figure follow the paper stock. It shifts slightly with
 * the pointer — a few pixels of parallax and a degree of tilt, no more. An
 * earlier pass turned it into a rotating canvas relief; a height map does not
 * survive being turned, so this is the restrained version instead.
 *
 * Regenerate after changing the source photo:
 *   python3 scripts/build-figure.py
 * ────────────────────────────────────────────────────────────────────────────
 *
 * Every bubble is sourced from cv.yml, papers.bib or a published sentence.
 * Nothing is inferred — which a generated persona could not claim, and which is
 * the whole point of putting this format on this site.
 */
import cv from '../data/cv.json';
import pubs from '../data/publications.json';
import site from '../data/site.json';
import figure from '../../public/figure.svg?raw';

type Section = { title: string; type?: string; contents?: any };
const map = Object.fromEntries(
  (cv as Section[])
    .filter((s) => s.type === 'map')
    .flatMap((s) => (s.contents as { name: string; value: any }[]).map((r) => [r.name, r.value])),
);
const interests = ((cv as Section[]).find((s) => s.title === 'Research Interests')?.contents ??
  []) as { title: string; items: string[] }[];

const coauthors = new Set(pubs.flatMap((p) => p.authors).filter((a) => a !== site.name));
const years = pubs.map((p) => p.year).filter(Boolean) as number[];

const langs = String(map['Languages'] ?? '')
  .split(',')
  .map((s) => s.trim())
  .filter(Boolean);

/**
 * Bubbles, with a position around the figure. `side` picks which edge the tail
 * hangs from; x/y are percentages of the stage.
 */
const bubbles = [
  {
    head: 'Position',
    body: `${site.role} · ${site.group}, ${site.affiliation}`,
    x: 2,
    y: 4,
    side: 'bl',
  },
  { head: 'Based in', body: map['Location'] ?? site.location, x: 60, y: 20, side: 'bl' },
  { head: 'Languages', body: langs.join(' · '), x: 0, y: 34, side: 'br' },
  {
    head: 'Record',
    body: `${pubs.length} publications, ${Math.min(...years)}–${Math.max(...years)} · ${coauthors.size} co-authors`,
    x: 55,
    y: 52,
    side: 'bl',
  },
  { head: 'Works on', body: interests.map((g) => g.title).join(' · '), x: 0, y: 70, side: 'tr' },
  {
    head: 'In his own words',
    body: 'A persona can be entirely plausible and still represent no one.',
    x: 40,
    y: 86,
    side: 'tl',
    wide: true,
  },
];
---

<div class="ph" data-set>
  <!-- left: the prose -->
  <div class="ph-text">
    <p class="ph-tag">Persona 01 · n = 1 · sourced, not generated</p>
    <h1 class="ph-name">{map['Full Name'] ?? site.name}</h1>

    <div class="prose ph-prose">
      <p>
        I am a {site.role.toLowerCase()} at the
        <a href={site.groupUrl} rel="noopener" target="_blank">{site.affiliation}</a>, supervised by
        <a href={site.supervisorUrl} rel="noopener" target="_blank">{site.supervisor}</a>. My work
        is about whether generative AI can represent users fairly — how these systems build
        personas, where they flatten the people they are meant to describe, and what that costs
        communities already thin on the ground in the training data.
      </p>
      <p>
        Alongside the doctorate I am Senior Data Science Lead at
        <a href="https://www.eniplenitude.fr/" rel="noopener" target="_blank">ENI Plenitude</a>;
        before that I built GenAI tools for designers at Samsung Design Innovation Center. That
        order matters — I keep shipping the kind of system I spend my papers criticising, which is
        a useful place to argue from.
      </p>
    </div>

    <details class="more">
      <summary>Longer version</summary>
      <div class="prose">
        <p>
          Before Samsung I built AI systems in engineering domains across Pakistan, the USA, MENA
          and Ireland, and came to research through practice rather than the other way round.
        </p>
        <p>
          I have run space education and popularisation in Pakistan for years through Space
          Technology Education and Popularization — World Space Week (2014–2022), Space Summer
          School (2017–2022) and Space Camps — and volunteer with the
          <a href="https://ncgsa.org.pk/" rel="noopener" target="_blank">National Center of GIS
          &amp; Space Applications</a>. Four languages, some poetry and dark prose, otherwise mostly
          overthinking or cooking.
        </p>
      </div>
    </details>

    <p class="ph-note">
      Every label opposite comes from a CV, a bibliography or a published sentence — nothing is
      inferred. A generated persona cannot make that claim, and the gap is the research.
    </p>
  </div>

  <!-- right: the figure, with the labels arranged around it -->
  <figure class="ph-stage">
    <div class="ph-figure" id="phFigure" set:html={figure} />

    <ul class="ph-bubbles">
      {
        bubbles.map((b, i) => (
          <li
            class:list={['ph-bub', `t-${b.side}`, b.wide && 'is-wide']}
            style={`--x:${b.x}%;--y:${b.y}%;--i:${i}`}
          >
            <p class="ph-bub-h">{b.head}</p>
            <p class="ph-bub-b">{b.body}</p>
          </li>
        ))
      }
    </ul>
  </figure>
</div>

<style>
  .ph {
    display: grid;
    gap: 1.5rem 2.5rem;
    margin: 0 0 1.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .ph {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  /* ---- left ---- */

  .ph-tag {
    margin: 0 0 0.4rem;
    font-family: var(--type);
    font-size: 0.6rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--mark);
  }

  .ph-name {
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0 0 0.9rem;
    font-weight: 400;
  }

  .ph-prose p {
    font-size: 1.02rem;
    line-height: 1.66;
  }

  .ph-note {
    margin: 1.1rem 0 0;
    padding-top: 0.6rem;
    border-top: 1.5px solid var(--rule);
    font-family: var(--type);
    font-size: 0.64rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* ---- right: stage ---- */

  .ph-stage {
    position: relative;
    margin: 0;
    /* the bubbles are positioned against this box, so it needs a stable ratio */
    aspect-ratio: 4 / 5;
  }

  /* the four ink levels the mesh is filled with */
  .ph-figure {
    --fig-1: #d8c8d1;
    --fig-2: #b07f9b;
    --fig-3: #7d456a;
    --fig-4: #2b2622;

    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 72%;
    line-height: 0;
  }

  /* on black card the same four levels run light-to-dark the other way */
  :global([data-stock='black']) .ph-figure {
    --fig-1: #3f3038;
    --fig-2: #7d5069;
    --fig-3: #b5789a;
    --fig-4: #f4efe3;
  }

  .ph-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: var(--blend);
  }

  /* the pointer nudge: a few pixels and a degree, driven by --px/--py */
  .js .ph-figure {
    --px: 0;
    --py: 0;
    transform: translate(-50%, -50%)
      translate3d(calc(var(--px) * 9px), calc(var(--py) * 7px), 0)
      rotate(calc(var(--px) * 1.1deg));
    transition: transform 420ms cubic-bezier(0.25, 0.9, 0.3, 1);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .ph-figure {
      transform: translate(-50%, -50%);
    }
  }

  /* ---- bubbles ---- */

  .ph-bubbles {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
  }

  .ph-bub {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 43%;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    box-shadow: 3px 3px 0 var(--mark);
    padding: 0.32rem 0.45rem 0.38rem;
  }

  .ph-bub.is-wide {
    width: 56%;
  }

  .ph-bub-h {
    margin: 0 0 0.1rem;
    font-family: var(--type);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mark);
  }

  .ph-bub-b {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--ink);
  }

  /* tails — a chat bubble points at whoever is speaking */
  .ph-bub::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--paper);
    border-right: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }

  .t-bl::after {
    left: 12px;
    bottom: -5px;
    transform: rotate(45deg);
  }

  .t-br::after {
    right: 12px;
    bottom: -5px;
    transform: rotate(45deg);
  }

  .t-tl::after {
    left: 12px;
    top: -5px;
    transform: rotate(225deg);
  }

  .t-tr::after {
    right: 12px;
    top: -5px;
    transform: rotate(225deg);
  }

  /* they land one after another, like messages arriving */
  .js .ph-bub {
    opacity: 0;
    transform: translateY(6px) scale(0.97);
    transition:
      opacity 260ms linear,
      transform 380ms cubic-bezier(0.34, 1.4, 0.64, 1);
    transition-delay: calc(320ms + var(--i) * 150ms);
  }

  .js .ph.is-set .ph-bub {
    opacity: 1;
    transform: translate3d(calc(var(--px, 0) * -4px), calc(var(--py, 0) * -3px), 0);
    transition:
      opacity 260ms linear,
      transform 520ms cubic-bezier(0.25, 0.9, 0.3, 1);
  }

  /* ---- narrow: the stage stops being a stage ---- */

  @media (max-width: 640px) {
    .ph-stage {
      aspect-ratio: auto;
    }

    .ph-figure {
      position: static;
      transform: none;
      width: 68%;
      margin: 0 auto 0.9rem;
      display: block;
    }

    .ph-bubbles {
      position: static;
      display: grid;
      gap: 0.4rem;
    }

    .ph-bub {
      position: static;
      width: auto;
    }

    .ph-bub.is-wide {
      width: auto;
    }

    .ph-bub::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .ph-bub {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  /**
   * Move the figure with the pointer. Normalised to [-1, 1] across the stage and
   * written as --px/--py, so the CSS decides how far anything actually travels;
   * the bubbles read the same values and drift the other way.
   */
  const stage = document.querySelector('.ph-stage') as HTMLElement | null;
  const group = document.querySelector('.ph') as HTMLElement | null;

  if (stage && group && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    let px = 0;
    let py = 0;

    function write() {
      frame = 0;
      group.style.setProperty('--px', px.toFixed(3));
      group.style.setProperty('--py', py.toFixed(3));
    }

    // the whole group is the target area, not just the figure, so the parallax
    // responds while you are reading the prose beside it
    group.addEventListener(
      'pointermove',
      (e) => {
        const r = group.getBoundingClientRect();
        px = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
        py = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        if (!frame) frame = requestAnimationFrame(write);
      },
      { passive: true },
    );

    group.addEventListener('pointerleave', () => {
      px = 0;
      py = 0;
      if (!frame) frame = requestAnimationFrame(write);
    });
  }
</script>
