---
import site from '../data/site.json';
import { publications as pubs, tally, coauthors, span, venueOf, generated } from '../lib/publications';

const venues = new Set(pubs.map(venueOf).filter(Boolean));
const firstAuthor = pubs.filter((p) => p.authors[0] === site.name).length;
const cites = pubs.reduce((n, p) => n + (p.citations || 0), 0);

/**
 * Published work and work under review are separate numbers.
 *
 * One "31 publications" tile folds ten manuscripts under review and a preprint
 * in with the peer-reviewed record. An editor or a programme chair counts the
 * list, finds twenty-one, and now doubts the rest of the page.
 */
const stats = [
  { n: tally.landed, l: 'published' },
  { n: tally.inReview, l: 'in review' },
  { n: firstAuthor, l: 'first-authored' },
  { n: venues.size, l: 'venues' },
  { n: coauthors.size, l: 'co-authors' },
  { n: span, l: 'span' },
  ...(cites > 0 ? [{ n: cites, l: 'citations', as: generated }] : []),
];
---

<ul class="pubstats" data-set>
  {stats.map((s) => (
    <li>
      <span class="pubstats-n">{s.n}</span>
      <span class="pubstats-l">{s.l}</span>
      {/* the counts are copied into papers.bib by hand, so they are a snapshot */}
      {s.as && <span class="pubstats-as">as of {s.as}</span>}
    </li>
  ))}
</ul>

<style>
  .pubstats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 1px;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    background: var(--rule);
    border: 1.5px solid var(--ink);
  }

  .pubstats li {
    background: var(--paper);
    padding: 0.6rem 0.7rem 0.55rem;
  }

  .pubstats-n {
    display: block;
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pubstats-as {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--type);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .pubstats-l {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--type);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
