---
import pubs from '../data/publications.json';
import site from '../data/site.json';

interface Props {
  selectedOnly?: boolean;
  showFilters?: boolean;
}
const { selectedOnly = false, showFilters = false } = Astro.props;

const items = selectedOnly ? pubs.filter((p) => p.selected) : pubs;
const years = [...new Set(items.map((p) => p.year))].sort((a, b) => (b ?? 0) - (a ?? 0));

const TYPE_LABEL: Record<string, string> = {
  inproceedings: 'Conference',
  article: 'Journal',
  incollection: 'Book chapter',
};

/**
 * Surnames only, first three, then a count — thirty-one full author lists was
 * the largest block of text on the page. The complete list is the title
 * attribute and the BibTeX.
 */
function authorLine(authors: string[]) {
  const surname = (a: string) => a.split(' ').slice(-1)[0];
  const shown = authors
    .slice(0, 3)
    .map((a) => (a === site.name ? `<b>${surname(a)}</b>` : surname(a)));
  const rest = authors.length - shown.length;
  return shown.join(', ') + (rest > 0 ? ` +${rest}` : '');
}

const typeCounts = Object.keys(TYPE_LABEL).map((t) => ({
  t,
  label: TYPE_LABEL[t],
  n: items.filter((p) => p.type === t).length,
}));

let n = 0;
---

{
  showFilters && (
    <div class="pubfilter">
      <div class="pubfilter-row">
        <input
          type="search"
          id="pf-q"
          placeholder="search title, author, venue…"
          autocomplete="off"
          spellcheck="false"
        />
        <select id="pf-year" aria-label="Filter by year">
          <option value="all">all years</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
      </div>

      <div class="filters" role="group" aria-label="Filter publications">
        <button type="button" data-f="all" aria-pressed="true">all {items.length}</button>
        {
          typeCounts
            .filter((c) => c.n > 0)
            .map((c) => (
              <button type="button" data-f={c.t} aria-pressed="false">
                {c.label.toLowerCase()} {c.n}
              </button>
            ))
        }
        <button type="button" data-f="selected" aria-pressed="false">
          selected {pubs.filter((p) => p.selected).length}
        </button>
        <button type="button" data-f="doi" aria-pressed="false">
          with doi {pubs.filter((p) => p.doi).length}
        </button>
      </div>

      <p class="pubfilter-count" id="pf-count" aria-live="polite" />
    </div>
  )
}

<div id="pub-root">
  {
    years.map((year) => (
      <div class="year-group" data-year={year}>
        <p class="year-label">
          {year}<span>{items.filter((p) => p.year === year).length} items</span>
        </p>
        <ul class="pubs">
          {items
            .filter((p) => p.year === year)
            .map((p) => {
              n += 1;
              const search = [p.title, p.authors.join(' '), p.venue, p.abbr, p.status]
                .join(' ')
                .toLowerCase();
              return (
                <li
                  class:list={['pub', p.selected && 'is-selected']}
                  data-key={p.key}
                  data-type={p.type}
                  data-year={p.year}
                  data-selected={p.selected ? 'true' : 'false'}
                  data-doi={p.doi ? 'true' : 'false'}
                  data-search={search}
                >
                  <span class="pub-n">{String(n).padStart(2, '0')}</span>
                  <h3 class="pub-title">
                    {p.doi ? (
                      <a href={`https://doi.org/${p.doi}`} rel="noopener" target="_blank">
                        {p.title}
                      </a>
                    ) : p.links[0] ? (
                      <a href={p.links[0].href} rel="noopener" target="_blank">
                        {p.title}
                      </a>
                    ) : (
                      p.title
                    )}
                  </h3>
                  <p class="pub-authors" title={p.authors.join(', ')} set:html={authorLine(p.authors)} />
                  <p class="pub-meta">
                    <span class="pub-venue">{p.abbr || p.venue}</span>
                    {p.status && !/^published$/i.test(p.status) && (
                      <span class="pub-status">{p.status}</span>
                    )}
                    {p.citations > 0 && <span>{p.citations} cit.</span>}
                  </p>

                  {/* every link al-folio surfaced, in its order */}
                  <ul class="pub-links">
                    {p.doi && (
                      <li>
                        <a href={`https://doi.org/${p.doi}`} rel="noopener" target="_blank">doi</a>
                      </li>
                    )}
                    {p.links.map((l) => (
                      <li>
                        <a href={l.href} rel="noopener" target="_blank">{l.label}</a>
                      </li>
                    ))}
                    {p.scholarId && (
                      <li>
                        <a
                          href={`https://scholar.google.com/citations?view_op=view_citation&citation_for_view=anC0OlUAAAAJ:${p.scholarId}`}
                          rel="noopener"
                          target="_blank"
                        >
                          scholar
                        </a>
                      </li>
                    )}
                    <li><button type="button" data-bib={p.key}>bibtex</button></li>
                  </ul>

                  <div class="bib" id={`bib-${p.key}`} hidden><pre>{p.raw}</pre></div>
                </li>
              );
            })}
        </ul>
      </div>
    ))
  }
  <p class="pubfilter-empty" id="pf-empty" hidden>Nothing matches those filters.</p>
</div>

<script>
  // bibtex drawers
  document.querySelectorAll<HTMLButtonElement>('[data-bib]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const box = document.getElementById(`bib-${btn.dataset.bib}`);
      if (box) box.hidden = !box.hidden;
    });
  });

  const rows = Array.from(document.querySelectorAll<HTMLElement>('#pub-root .pub'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('#pub-root .year-group'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filters button'));
  const q = document.getElementById('pf-q') as HTMLInputElement | null;
  const yearSel = document.getElementById('pf-year') as HTMLSelectElement | null;
  const count = document.getElementById('pf-count');
  const empty = document.getElementById('pf-empty');

  if (rows.length && buttons.length) {
    // the three controls compose rather than override each other
    let kind = 'all';

    function apply() {
      const needle = (q?.value ?? '').trim().toLowerCase();
      const year = yearSel?.value ?? 'all';
      let shown = 0;

      rows.forEach((r) => {
        const okKind =
          kind === 'all' ||
          (kind === 'selected'
            ? r.dataset.selected === 'true'
            : kind === 'doi'
              ? r.dataset.doi === 'true'
              : r.dataset.type === kind);
        const okYear = year === 'all' || r.dataset.year === year;
        const okText = !needle || (r.dataset.search ?? '').includes(needle);
        const show = okKind && okYear && okText;
        r.hidden = !show;
        if (show) shown += 1;
      });

      groups.forEach((g) => {
        g.hidden = !Array.from(g.querySelectorAll<HTMLElement>('.pub')).some((r) => !r.hidden);
      });

      if (count) {
        const bits = [`${shown} of ${rows.length}`];
        if (kind !== 'all') bits.push(kind);
        if (year !== 'all') bits.push(year);
        if (needle) bits.push(`“${needle}”`);
        count.textContent = bits.join(' · ');
      }
      if (empty) empty.hidden = shown > 0;

      // a term selected in the projector no longer applies once filters move
      const note = document.getElementById('pub-note');
      if (note) note.hidden = true;
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        kind = btn.dataset.f ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply();
      });
    });

    q?.addEventListener('input', apply);
    yearSel?.addEventListener('change', apply);
    apply();
  }
</script>
