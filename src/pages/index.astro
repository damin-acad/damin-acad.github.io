---
import Base from '../layouts/Base.astro';
import PublicationList from '../components/PublicationList.astro';
import site from '../data/site.json';
import pubs from '../data/publications.json';
import { getCollection } from 'astro:content';

const selected = pubs.filter((p) => p.selected);
const years = pubs.map((p) => p.year).filter(Boolean) as number[];
const essays = await getCollection('writing');
const essayWords = essays.reduce(
  (n, p) => n + (p.body ?? '').split(/\s+/).filter(Boolean).length,
  0,
);
---

<Base>
  <section class="section" data-set>
    <p class="section-tab">Fig. 0 — who</p>
    <h1 class="page-title">How generative AI represents the people it claims to serve</h1>
    <p class="page-lede">
      — and what that gets wrong. Doctoral research at the {site.affiliation}, alongside building
      the systems it critiques.
    </p>

    <!-- facts as a table rather than four paragraphs of prose -->
    <dl class="facts">
      <div>
        <dt>Position</dt>
        <dd>
          {site.role}, <a href={site.groupUrl} rel="noopener" target="_blank">{site.group}</a>,
          {' '}{site.affiliation}
        </dd>
      </div>
      <div>
        <dt>Supervisor</dt>
        <dd><a href={site.supervisorUrl} rel="noopener" target="_blank">{site.supervisor}</a></dd>
      </div>
      <div>
        <dt>Also</dt>
        <dd>
          Senior Data Science Lead,
          <a href="https://www.eniplenitude.fr/" rel="noopener" target="_blank">ENI Plenitude</a>
          {' '}· previously AI Research Scientist, Samsung Design Innovation Center
        </dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>{site.interests.slice(0, 4).join(' · ')}</dd>
      </div>
      <div>
        <dt>Output</dt>
        <dd>
          <a href="/publications">{pubs.length} publications</a>, {Math.min(...years)}–{Math.max(...years)}
          {' '}· <a href="/writing">{essays.length} essays</a>,
          {' '}{essayWords.toLocaleString('en-GB')} words
        </dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{site.location}</dd>
      </div>
    </dl>

    <details class="more">
      <summary>Longer version</summary>
      <div class="prose">
        <p>
          My research centres on making GenAI systems fairer in how they represent users. I study
          how these systems generate user personas and work to reduce bias, particularly for
          marginalised communities — the goal being systems that do not quietly launder
          stereotypes into design decisions.
        </p>
        <p>
          Before Plenitude I built GenAI tools at Samsung Design Innovation Center in France to
          help designers create more representative products, and AI systems in engineering
          domains across Pakistan, the USA, MENA and Ireland.
        </p>
        <p>
          I have run space education and popularisation in Pakistan for years through Space
          Technology Education and Popularization — World Space Week (2014–2022), Space Summer
          School (2017–2022) and Space Camps — and volunteer with the
          <a href="https://ncgsa.org.pk/" rel="noopener" target="_blank">National Center of GIS
          &amp; Space Applications</a>. Four languages, some poetry, mostly overthinking or
          cooking.
        </p>
      </div>
    </details>
  </section>

  <section class="section" data-set>
    <div class="section-head">
      <h2 class="section-title">Selected work</h2>
      <span class="section-count">
        {selected.length} of {pubs.length} · <a href="/publications">all publications</a>
      </span>
    </div>
    <PublicationList selectedOnly />
  </section>
</Base>
