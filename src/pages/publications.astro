---
import Base from '../layouts/Base.astro';
import PublicationList from '../components/PublicationList.astro';
import Projector from '../components/Projector.astro';
import site from '../data/site.json';
import { publications as pubs, tally, coauthors, generated } from '../lib/publications';

const years = [...new Set(pubs.map((p) => p.year))].filter(Boolean).sort();
const withDoi = pubs.filter((p) => p.doi).length;
---

<Base title="publications" description={`${tally.landed} published and ${tally.inReview} under-review works on generative AI, personas and user representation.`}>
  <section class="section" data-set>
    <p class="section-tab">Fig. 1 — record</p>
    <h1 class="page-title">Publications</h1>
    <p class="page-lede">
      {tally.landed} published or accepted and {tally.inReview} under review, {years[0]}–{years[years.length - 1]},
      generated from <code>papers.bib</code> — {withDoi} with a DOI, {coauthors.size} co-authors.
      Every entry carries its BibTeX. Citation counts as of {generated}.
    </p>
  </section>

  <section class="section" data-set>
    <div class="section-head">
      <h2 class="section-title">The shape of the record</h2>
    </div>
    <Projector />
  </section>

  <section class="section" data-set>
    <div class="section-head">
      <h2 class="section-title">All publications</h2>
      <span class="section-count">
        <a href={site.socials.scholar} rel="noopener" target="_blank">Scholar</a> ·
        <a href={site.socials.orcid} rel="noopener" target="_blank">ORCID</a>
      </span>
    </div>
        <p class="typed" id="pub-note" hidden></p>
    <PublicationList showFilters />
  </section>
</Base>
